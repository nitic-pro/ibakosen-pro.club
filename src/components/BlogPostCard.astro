---
import type { CollectionEntry } from 'astro:content';
import { cardClass } from '../lib/ui';
import { formatJaDate } from '../lib/blog';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const searchText = [post.data.title, post.data.description, ...post.data.tags].join(' ').toLowerCase();
---

<a class={`${cardClass} block no-underline`} data-post-card data-search={searchText} href={`/blog/${post.id}`}>
	<p class="font-mono text-[0.78rem] text-ink-muted">{formatJaDate(post.data.pubDate)}</p>
	<h2 class="mt-1.5 font-display text-[1.15rem] font-bold text-ink">{post.data.title}</h2>
	<p class="mt-2 text-[0.9rem] leading-relaxed text-ink-muted">{post.data.description}</p>
	{
		post.data.tags.length > 0 && (
			<div class="mt-3 flex flex-wrap gap-2">
				{post.data.tags.map((tag) => (
					<span class="rounded border border-neon-green/30 bg-bg/60 px-2.5 py-1 font-mono text-[0.72rem] text-neon-green">
						#{tag}
					</span>
				))}
			</div>
		)
	}
</a>
