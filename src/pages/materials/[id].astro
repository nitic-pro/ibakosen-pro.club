---
import { getCollection, render } from 'astro:content';
import PageShell from '../../layouts/PageShell.astro';
import { siteName } from '../../lib/ui';
import { formatJaDate } from '../../lib/blog';

export async function getStaticPaths() {
	const items = await getCollection('materials');
	return items.map((item) => ({
		params: { id: item.id },
		props: { item },
	}));
}

const { item } = Astro.props;
const { Content } = await render(item);

const isPdf = (url: string) => url.toLowerCase().endsWith('.pdf');
---

<PageShell
	description={item.data.description ?? `${item.data.event}の資料です。`}
	title={`${item.data.title} | ${siteName}`}
>
	<article class="pt-16 pb-16">
		<a class="font-mono text-[0.82rem] text-neon-cyan no-underline hover:underline" href="/materials">← 資料一覧</a>
		<header class="mt-6 mb-10 border-b border-neon-cyan/10 pb-8">
			<p class="font-mono text-[0.8rem] text-ink-muted">
				{formatJaDate(item.data.date)} ・ {item.data.event}
			</p>
			<h1
				class="mt-2 font-display text-[clamp(1.7rem,4vw,2.4rem)] font-black tracking-tight text-ink [text-shadow:0_0_10px_rgba(0,240,255,0.4)]"
			>
				{item.data.title}
			</h1>
		</header>

		<div class="prose-cyber mx-auto max-w-[680px]">
			<Content />
		</div>

		<div class="mx-auto mt-10 flex max-w-[680px] flex-col gap-8">
			{
				item.data.files.map((file) =>
					isPdf(file.url) ? (
						<div class="card-corners relative rounded border border-neon-cyan/20 bg-bg-card/60 p-4">
							<p class="mb-3 font-mono text-[0.85rem] text-ink">{file.label}</p>
							<div class="flex flex-col items-center gap-4" data-pdf-src={file.url} data-pdf-viewer>
								<p class="pdf-status font-mono text-[0.8rem] text-neon-cyan">
									<span class="animate-pulse-dot">読み込み中...</span>
								</p>
							</div>
							<a
								class="mt-3 inline-block font-mono text-[0.78rem] text-neon-cyan no-underline hover:underline"
								href={file.url}
								rel="noreferrer"
								target="_blank"
							>
								新しいタブで開く ↗
							</a>
						</div>
					) : (
						<a
							class="inline-flex items-center gap-1.5 font-mono text-[0.85rem] text-neon-cyan no-underline hover:underline"
							href={file.url}
							rel="noreferrer"
							target="_blank"
						>
							{file.label} ↗
						</a>
					),
				)
			}
		</div>
	</article>
</PageShell>

<script>
	import * as pdfjsLib from 'pdfjs-dist';
	import pdfWorkerUrl from 'pdfjs-dist/build/pdf.worker.min.mjs?url';

	async function renderPdfViewer(container: HTMLElement) {
		const src = container.dataset.pdfSrc;
		if (!src) return;

		try {
			pdfjsLib.GlobalWorkerOptions.workerSrc = pdfWorkerUrl;
			const doc = await pdfjsLib.getDocument(src).promise;
			container.innerHTML = '';

			for (let pageNumber = 1; pageNumber <= doc.numPages; pageNumber++) {
				const page = await doc.getPage(pageNumber);
				const targetWidth = container.clientWidth || 640;
				const unscaledViewport = page.getViewport({ scale: 1 });
				const viewport = page.getViewport({ scale: targetWidth / unscaledViewport.width });

				const canvas = document.createElement('canvas');
				canvas.width = viewport.width;
				canvas.height = viewport.height;
				canvas.className = 'w-full rounded border border-neon-cyan/15 shadow-[0_4px_24px_rgba(0,240,255,0.12)]';

				await page.render({ canvas, viewport }).promise;

				const pageLabel = document.createElement('p');
				pageLabel.className = 'font-mono text-[0.72rem] text-ink-muted';
				pageLabel.textContent = `${pageNumber} / ${doc.numPages}`;

				const wrapper = document.createElement('div');
				wrapper.className = 'flex w-full flex-col items-center gap-1.5';
				wrapper.append(canvas, pageLabel);
				container.appendChild(wrapper);
			}
		} catch (error) {
			console.error(error);
			container.innerHTML =
				'<p class="font-mono text-[0.8rem] text-ink-muted">プレビューを読み込めませんでした。下のリンクから開いてください。</p>';
		}
	}

	document.querySelectorAll<HTMLElement>('[data-pdf-viewer]').forEach(renderPdfViewer);
</script>
