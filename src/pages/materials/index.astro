---
import { getCollection } from 'astro:content';
import PageShell from '../../layouts/PageShell.astro';
import PageHeader from '../../components/PageHeader.astro';
import { cardClass, siteName } from '../../lib/ui';
import { formatJaDate } from '../../lib/blog';

const items = (await getCollection('materials')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<PageShell
	description="コンテストや発表会で使用したスライド・ポスター・LPなどの資料をまとめています。"
	title={`資料 | ${siteName}`}
>
	<PageHeader
		description="コンテストや発表会に出たときのスライド・ポスター・LPなどをここにまとめています。"
		title="資料"
	/>

	<section class="!border-t-0 pt-8 pb-16">
		<div class="mx-auto flex max-w-[720px] flex-col gap-5">
			{
				items.length === 0 && (
					<p class="text-center font-mono text-[0.9rem] text-ink-muted">まだ資料はありません。</p>
				)
			}
			{
				items.map((item) => (
					<a class={`${cardClass} block no-underline`} href={`/materials/${item.id}`}>
						<p class="font-mono text-[0.78rem] text-ink-muted">
							{formatJaDate(item.data.date)} ・ {item.data.event}
						</p>
						<h2 class="mt-1.5 font-display text-[1.1rem] font-bold text-ink">{item.data.title}</h2>
						{item.data.description && (
							<p class="mt-2 text-[0.88rem] leading-relaxed text-ink-muted">{item.data.description}</p>
						)}
						<p class="mt-3 font-mono text-[0.78rem] text-neon-cyan">続きを読む →</p>
					</a>
				))
			}
		</div>
	</section>
</PageShell>
