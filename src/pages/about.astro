import Divisions from '../components/sections/Divisions.astro';
import Activities from '../components/sections/Activities.astro';
import TechStack from '../components/sections/TechStack.astro';
---

<PageShell description="活動内容や使用技術を紹介しています。" title={`同好会について | ${siteName}`}>
