---
import { Font } from "astro:assets";
import "../styles/global.css";
import { siteName } from "../lib/ui";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = siteName,
    description = "茨城高専プログラミング同好会の公式サイトです。活動内容や部員募集情報を紹介しています。",
} = Astro.props;
---

<!doctype html>
<html lang="ja">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="description" content={description} />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <Font cssVariable="--font-jetbrains-mono" preload />
        <Font cssVariable="--font-orbitron" preload />
        <Font cssVariable="--font-akihabara-src" preload />
    </head>
    <body>
        <div class="bg-scanlines" aria-hidden="true"></div>
        <div class="bg-grid-floor animate-grid-drift" aria-hidden="true"></div>
        <div class="bg-noise-glow" aria-hidden="true"></div>
        <slot />
    </body>
</html>
